---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { locales, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Equivalent page in every language, for the language switcher. */
  alternates: Record<Lang, string>;
  /** Transparent header over a full-bleed hero (Home). */
  overlayHeader?: boolean;
  /** Model code to prefill in the WhatsApp message. */
  model?: string;
  /** Share image for Open Graph (see SEO). */
  image?: ImageMetadata;
  /** Keep the page out of search engines and without alternates (404). */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  alternates,
  overlayHeader = false,
  model,
  image,
  noindex,
} = Astro.props;
const t = useTranslations(lang);
---

<html lang={locales[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SEO
      lang={lang}
      title={title}
      description={description}
      alternates={alternates}
      image={image}
      noindex={noindex}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-schibsted" preload={[{ weight: 900 }, { weight: 400 }]} />
    <!-- Motion gate (D-12) and stored theme pick (D-13), applied before the first paint. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: follow the system preference.
      }
    </script>
  </head>
  <body class="relative">
    <a
      href="#main"
      class="bg-asphalt text-paper sr-only z-50 rounded-full px-4 py-2 font-bold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('nav.skip')}
    </a>
    <div class="scroll-progress brand-rule fixed inset-x-0 top-0 z-40 h-1" aria-hidden="true"></div>
    <Header lang={lang} alternates={alternates} overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} model={model} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
