---
import type { Lang } from '../i18n/ui';
import { fill, useTranslations } from '../i18n/utils';
import { whatsappUrl } from '../site';

interface Props {
  lang: Lang;
  /** Model code to prefill in the message, on model pages. */
  model?: string;
}

const { lang, model } = Astro.props;
const t = useTranslations(lang);
const message = model ? fill(t('wa.messageModel'), { model }) : t('wa.message');
---

<a
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener"
  aria-label={t('wa.label')}
  class="bg-whatsapp fixed right-[max(18px,env(safe-area-inset-right,0px))] bottom-[max(18px,env(safe-area-inset-bottom,0px))] z-30 grid size-14.5 place-items-center rounded-full text-white shadow-[0_6px_18px_rgb(0_0_0/0.22)] transition-transform duration-200 hover:scale-108"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" class="size-7.5">
    <path
      fill="currentColor"
      d="M16 3a13 13 0 0 0-11.3 19.4L3 29l6.8-1.8A13 13 0 1 0 16 3Zm0 23.6c-2 0-4-.5-5.7-1.6l-.4-.2-4 1 1.1-3.9-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.6 3.6 0 0 0-1.1 2.7 6.3 6.3 0 0 0 1.3 3.3 14.4 14.4 0 0 0 5.5 4.9c2 .9 2.8.9 3.8.8a3.3 3.3 0 0 0 2.2-1.5 2.7 2.7 0 0 0 .2-1.5c-.1-.2-.3-.3-.6-.4Z"
    ></path>
  </svg>
</a>
