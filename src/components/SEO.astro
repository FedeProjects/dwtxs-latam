---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import defaultImage from '../assets/images/general/hero-1.jpg';
import { locales, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { indexable } from '../site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Equivalent page in every language: canonical and hreflang links. */
  alternates: Record<Lang, string>;
  /** Share image (Open Graph), cropped to 1200×630. Defaults to a jobsite photo. */
  image?: ImageMetadata;
  /** Pages that must never be indexed or linked as alternates (404). */
  noindex?: boolean;
}

const { lang, title, description, alternates, image = defaultImage, noindex = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;

const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogLocale = (l: Lang) => locales[l].replace('-', '_');
const otherLangs = (Object.keys(alternates) as Lang[]).filter((l) => l !== lang);
---

{(!indexable || noindex) && <meta name="robots" content="noindex" />}
<title>{title}</title>
<meta name="description" content={description} />
{!noindex && (
  <>
    <link rel="canonical" href={abs(alternates[lang])} />
    {(Object.keys(alternates) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={locales[l]} href={abs(alternates[l])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(alternates.pt)} />
  </>
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={t('site.name')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(alternates[lang])} />
<meta property="og:image" content={abs(og.src)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale(lang)} />
{otherLangs.map((l) => (
  <meta property="og:locale:alternate" content={ogLocale(l)} />
))}
<meta name="twitter:card" content="summary_large_image" />
