---
import type { Lang } from '../i18n/ui';
import { fill, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Model code (or accessory name) sent with the enquiry from a product page. */
  model?: string;
  /** Preselected inquiry reason. */
  reason?: 'machine' | 'accessories' | 'other';
  /** On the red band the submit button turns charcoal so it stays visible. */
  onBand?: boolean;
}

// Enquiries go by email through Web3Forms (PROJECT_SPEC D-16). Without JS the form posts straight
// to the endpoint; with JS it validates in the page language and shows the result inline.
const { lang, model, reason = 'machine', onBand = false } = Astro.props;
const t = useTranslations(lang);

const ENDPOINT = 'https://api.web3forms.com/submit';
// Public by design: it can only send to the inbox it was created for.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

const subject = [t('form.subjectPrefix'), t('site.name'), model].filter(Boolean).join(' · ');

const field =
  'bg-paper text-asphalt focus:border-asphalt aria-[invalid=true]:border-asphalt w-full min-w-0 rounded-xl border-2 border-transparent px-3.5 py-3 text-[17px]/[1.3] transition-colors outline-none';
const label = 'grid min-w-0 content-start gap-1.5 text-[15px] font-medium';
const error = 'text-sm font-bold';
---

<form
  class="grid gap-3.5 md:grid-cols-2"
  action={ENDPOINT}
  method="POST"
  data-rise
  data-contact-form
  data-msg-required={t('form.errorRequired')}
  data-msg-email={t('form.errorEmail')}
  data-msg-sending={t('form.sending')}
  data-msg-success={t('form.success')}
  data-msg-failed={t('form.failed')}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="from_name" value={t('site.name')} />
  <input type="hidden" name="lang" value={lang} />
  <!-- Honeypot: people never see it, bots fill it in and the submission is dropped -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none"
    tabindex="-1"
    autocomplete="off"
  />

  {model && (
    <>
      <input type="hidden" name="model" value={model} />
      <span class="bg-asphalt text-concrete justify-self-start rounded-full px-4 py-2.5 font-bold md:col-span-2">
        {fill(t(reason === 'accessories' ? 'form.accessory' : 'form.model'), { model })}
      </span>
    </>
  )}

  <div class={label}>
    <label for="cf-name">{t('form.name')}</label>
    <input class={field} id="cf-name" name="name" autocomplete="name" required />
    <p class={error} id="cf-name-error" data-error hidden></p>
  </div>
  <div class={label}>
    <label for="cf-company">{t('form.company')}</label>
    <input class={field} id="cf-company" name="company" autocomplete="organization" />
  </div>
  <div class={label}>
    <label for="cf-email">{t('form.email')}</label>
    <input class={field} id="cf-email" name="email" type="email" autocomplete="email" required />
    <p class={error} id="cf-email-error" data-error hidden></p>
  </div>
  <div class={label}>
    <label for="cf-phone">{t('form.phone')}</label>
    <input class={field} id="cf-phone" name="phone" type="tel" autocomplete="tel" />
  </div>
  <div class:list={[label, 'md:col-span-2']}>
    <label for="cf-reason">{t('form.reason')}</label>
    <select class={field} id="cf-reason" name="reason">
      <option value="machine" selected={reason === 'machine'}>
        {t('form.reasonMachine')}
      </option>
      <option value="accessories" selected={reason === 'accessories'}>
        {t('form.reasonAccessories')}
      </option>
      <option value="other" selected={reason === 'other'}>
        {t('form.reasonOther')}
      </option>
    </select>
  </div>
  <div class:list={[label, 'md:col-span-2']}>
    <label for="cf-message">{t('form.message')}</label>
    <textarea class={field} id="cf-message" name="message" rows="4" required></textarea>
    <p class={error} id="cf-message-error" data-error hidden></p>
  </div>

  {accessKey ? (
    <button
      class:list={['btn justify-self-start md:col-span-2', onBand && 'btn-ink']}
      type="submit"
    >
      {t('form.submit')}
    </button>
  ) : (
    <p class="bg-paper text-asphalt rounded-xl p-4 font-medium md:col-span-2">
      {t('form.unavailable')}
    </p>
  )}
  <p
    class="bg-paper text-asphalt rounded-xl p-4 font-medium empty:hidden md:col-span-2"
    role="status"
    aria-live="polite"
    data-status
  ></p>
</form>

<script>
  // Progressive enhancement: validate in the page language, send with fetch, show the result inline.
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.noValidate = true;
    const msg = form.dataset;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];

    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const out = document.getElementById(`${el.id}-error`);
      const text = el.validity.valueMissing
        ? msg.msgRequired
        : el.validity.typeMismatch
          ? msg.msgEmail
          : '';
      el.setAttribute('aria-invalid', String(Boolean(text)));
      if (text) el.setAttribute('aria-describedby', `${el.id}-error`);
      else el.removeAttribute('aria-describedby');
      if (out) {
        out.textContent = text ?? '';
        out.hidden = !text;
      }
      return !text;
    };

    // Once a field has shown an error, re-check it as the reader types.
    fields.forEach((el) =>
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') check(el);
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      if (!button) return;

      const label = button.textContent;
      button.disabled = true;
      button.textContent = msg.msgSending ?? '';
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = (await res.json()) as { success?: boolean };
        if (!res.ok || !data.success) throw new Error('Submission rejected');
        form.reset();
        status.textContent = msg.msgSuccess ?? '';
      } catch {
        status.textContent = msg.msgFailed ?? '';
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
