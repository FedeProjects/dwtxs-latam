---
import { CATEGORIES } from '../content/specs';
import type { Lang } from '../i18n/ui';
import { categoryPath, homePath, pagePath, useCatalogLabels, useTranslations } from '../i18n/utils';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { categories } = useCatalogLabels(lang);

const columns = [
  {
    title: t('footer.machines'),
    links: [
      ...CATEGORIES.map((c) => ({ href: categoryPath(lang, c), label: categories[c] })),
      { href: pagePath(lang, 'accessories'), label: t('nav.accessories') },
    ],
  },
  {
    title: t('footer.company'),
    links: [
      { href: pagePath(lang, 'about'), label: t('nav.about') },
      { href: `${homePath(lang)}#servicos`, label: t('home.services.tech') },
      { href: pagePath(lang, 'contact'), label: t('nav.contact') },
    ],
  },
];
---

<footer class="bg-chrome text-on-chrome">
  <div class="brand-rule h-1" aria-hidden="true"></div>
  <div class="gut">
    <div class="mx-auto max-w-330">
      <div class="grid grid-cols-2 gap-8 pt-14 pb-8 md:grid-cols-[minmax(0,4fr)_repeat(3,minmax(0,2fr))]">
        <div class="col-span-2 md:col-span-1">
          <a href={homePath(lang)} class="inline-block">
            <Logo lang={lang} height={48} class="h-12" />
          </a>
          <p class="text-on-chrome/70 mt-3 max-w-[32ch] text-base">{t('footer.tagline')}</p>
        </div>
        {columns.map(({ title, links }) => (
          <div>
            <h2 class="mb-3 text-base tracking-normal">{title}</h2>
            <ul class="grid gap-2 text-base">
              {links.map(({ href, label }) => (
                <li>
                  <a href={href} class="no-underline hover:underline">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <h2 class="mb-3 text-base tracking-normal">{t('footer.contact')}</h2>
          <ul class="grid gap-2 text-base">
            <li>
              {t('contact.whatsapp')} {t('common.tbd')}
            </li>
            <li>
              {t('contact.email')} {t('common.tbd')}
            </li>
          </ul>
        </div>
      </div>
      <div class="border-on-chrome/15 text-on-chrome/70 flex flex-wrap justify-between gap-3 border-t pt-5 pb-10 text-sm">
        <span>{t('footer.legal')}</span>
        <span>{t('footer.preview')}</span>
      </div>
    </div>
  </div>
</footer>
