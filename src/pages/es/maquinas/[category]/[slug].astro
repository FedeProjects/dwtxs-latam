---
import { getCollection } from 'astro:content';
import ModelPage from '../../../../components/ModelPage.astro';
import { categorySegments } from '../../../../i18n/routes';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((model) => ({
    params: { category: categorySegments.es[model.data.category], slug: model.id },
    props: { model },
  }));
}

const { model } = Astro.props;
---

<ModelPage lang="es" model={model} />
