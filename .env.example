# Environment variables for DWTXS LATAM. Copy to .env and fill in.

# Web3Forms access key (https://web3forms.com): public by design, it only sends to the inbox it was created for.
PUBLIC_WEB3FORMS_KEY=00000000-0000-0000-0000-000000000000

# Absolute site URL for canonical, hreflang, Open Graph and the sitemap. Leave empty to use the final domain.
SITE_URL=https://example.vercel.app
